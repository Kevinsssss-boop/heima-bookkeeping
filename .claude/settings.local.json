{
  "permissions": {
    "allow": [
      "Bash(npx electron *)",
      "Bash(node -e \"console.log\\(require\\('electron/package.json'\\).version\\)\")",
      "Bash(node -e \"const e = require\\('electron'\\); console.log\\('app:', typeof e.app\\); console.log\\('BrowserWindow:', typeof e.BrowserWindow\\);\")",
      "Bash(cat)",
      "Bash(npm install *)",
      "Bash(taskkill /F /IM electron.exe)",
      "Bash(rm -rf node_modules/electron)",
      "Bash(powershell *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(git *)",
      "Bash(npx vitest *)",
      "Bash(npm audit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File scripts/check-gate.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
